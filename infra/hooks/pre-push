#!/usr/bin/env bash
#
# Every push to GitHub passes infra/check-outgoing.sh first - the publish
# checks over the commits being sent. Enabled once per clone with:
#
#   git config core.hooksPath infra/hooks
#
# Also refuses the branch private-history: the history from before the
# repository went public, which still holds what the publish scrub removed.
# It stays on this machine.

set -Eeuo pipefail
remote=$1
url=$2
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000

[[ $url == *github.com* ]] || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue # a deletion sends no commits
  if [[ $local_ref == refs/heads/private-history || $remote_ref == refs/heads/private-history ]]; then
    echo "pre-push: private-history never leaves this machine" >&2
    exit 1
  fi
  echo "pre-push: checking $local_ref -> $remote ($remote_ref)"
  if [[ $remote_sha != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    bash "$root/infra/check-outgoing.sh" "$remote_sha..$local_sha"
  else
    # A new branch: every commit GitHub does not have yet.
    bash "$root/infra/check-outgoing.sh" "$local_sha" --not --remotes="$remote"
  fi
done
