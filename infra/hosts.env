# The codeinchrome fleet. Not secret: every one of these is already public in
# the codeinchrome.com DNS zone. Committed so the fleet is not knowledge that
# lives only in one person's shell history.
#
# Customer hosts. h2 is NOT here: it runs the control plane, which holds every
# agent token and the Cloudflare key, and those do not belong on a machine that
# also runs customer containers.
# Add a host with infra/add-host.sh, which appends it here and does the rest.
CIC_HOSTS="h1:203.0.113.105 h3:203.0.113.102 h4:203.0.113.103"
# Hosts taking no NEW sites, e.g. "h3:draining" (their sites keep running).
CIC_HOST_STATES=""
CIC_CONTROL_HOST="h2:203.0.113.104"
# Addresses no script may ever touch (a server outside this fleet) are kept
# out of the repository, in infra/hosts.local.env; every script refuses them.
CIC_FORBIDDEN_HOSTS=""
if [ -f infra/hosts.local.env ]; then
  . infra/hosts.local.env
elif [ -d infra ]; then
  # In a checkout (not on the control server, where only CIC_HOSTS is read).
  echo "note: infra/hosts.local.env not found - no extra addresses are refused" >&2
fi
