# The codeinchrome fleet registry - the ONE place every script and the control
# plane (config/fleet.php) learn which hosts exist.
#
# The addresses are NOT in this committed file: they live in
# infra/hosts.local.env beside it (never committed), which sets:
#
#   CIC_HOSTS="h1:<ip> h3:<ip> ..."   customer hosts (hN reached on 9440+N)
#   CIC_CONTROL_HOST="h2:<ip>"         the control plane - never a customer host
#   CIC_FORBIDDEN_HOSTS="<ip> ..."     addresses no script may ever touch
#
# Add a host with infra/add-host.sh, which registers it there and does the rest.
CIC_HOSTS=""
CIC_CONTROL_HOST=""
CIC_FORBIDDEN_HOSTS=""
# Hosts taking no NEW sites, e.g. "h3:draining" (their sites keep running).
CIC_HOST_STATES=""

cic_registry_dir=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
if [ -f "$cic_registry_dir/hosts.local.env" ]; then
  # shellcheck disable=SC1091
  . "$cic_registry_dir/hosts.local.env"
elif [ -d "$cic_registry_dir/../infra" ] || [ "$(basename "$cic_registry_dir")" = infra ]; then
  echo "note: $cic_registry_dir/hosts.local.env not found - no hosts are known" >&2
fi
